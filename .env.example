# TickTick OAuth2 credentials
# Get these from https://developer.ticktick.com after creating an app
TICKTICK_CLIENT_ID=your_client_id_here
TICKTICK_CLIENT_SECRET=your_client_secret_here

# These will be filled automatically after authentication
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=

# MCP Remote Server Configuration
# IMPORTANT: Change this to a secure password!
MCP_PASSWORD=your-secure-password-here

# Optional: API host configuration
# For TickTick International: https://api.ticktick.com (default)
# For Dida365 (China): https://api.dida365.com
API_HOST=https://api.ticktick.com